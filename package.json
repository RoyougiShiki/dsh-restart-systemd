{
  "name": "dsh-restart-systemd",
  "version": "0.3.0",
  "description": "WebUI restart button (systemd) for DeepSeek Harness: a sidebar-footer restart trigger that schedules systemctl --user restart dsh-web on Linux/WSL, with single-flight dedup, a loopback security fence, and a post-restart suppression flag.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RoyougiShiki/dsh-restart-systemd.git"
  },
  "homepage": "https://github.com/RoyougiShiki/dsh-restart-systemd",
  "bugs": {
    "url": "https://github.com/RoyougiShiki/dsh-restart-systemd/issues"
  },
  "author": "dsh-restart-systemd contributors",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "systemd",
    "systemctl",
    "wsl",
    "webui"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.7-rc.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -b && node scripts/build-client.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b --pretty false",
    "test": "npm run build && npm run test:client && npm run test:host",
    "test:client": "node scripts/verify-client.mjs",
    "test:host": "node scripts/verify-host.mjs",
    "fixture": "node scripts/ui-fixture.mjs"
  }
}
